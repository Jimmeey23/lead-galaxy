# Copy this file to .env.local, fill in the values, then restart the dev server.
# Never commit .env.local or real credentials. Keep secrets server-side.

# Optional database: required to persist follow-up cadence settings.
DATABASE_URL=

# Optional Momence integration: use an authorized session cookie string.
MOMENCE_ALL_COOKIES=
# Enables automatic login + TOTP renewal when cookies are missing/rejected.
MOMENCE_EMAIL=
MOMENCE_PASSWORD=
MOMENCE_TOTP_SECRET=
# Save refreshed cookies to this project's .env.local (local/self-hosted only).
# Vercel uses the renewed cookie in memory; deployment env vars are not rewritten.
MOMENCE_PERSIST_ENV=true
# Regional host routing is built in: Bengaluru 33905; Mumbai 13752.

# Google Sheets sources. These defaults are also used when variables are empty.
SHEET_ID=1dQMNF69WnXVQdhlLvUZTig3kL97NA21k6eZ9HRu6xiQ
SHEET_GID=256104486
SALES_SHEET_ID=1HbGnJk-peffUp7XoXSlsL55924E9yUt8cP_h93cdTT0
CHECKINS_SHEET_ID=1a7XKv2WCog7o8nYuV8YcFdqtfPYJNRO6DelJ6Hn_z6Q

# Reserved for a future OpenAI integration. Current AI insights use local rules;
# the app does not currently read or send this key to a provider.
OPENAI_API_KEY=
